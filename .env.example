# PayU LATAM + Mercado Pago — nombres de variables (SIN secretos).
# Copia a .env.local y rellena. Jamás commitees valores reales.
# Guías: docs/payu-latam-produccion.md · docs/mercadopago-checkout-pro.md

# --- Entorno (explícito, gana sobre el legado) ---
PAYU_LATAM_ENV=sandbox
# production | sandbox

# --- Credenciales PayU (SOLO servidor, sin prefijo NEXT_PUBLIC) ---
# Sandbox: usa los valores oficiales de developers.payulatam.com → "Probar tu solución".
# Producción: Módulo PayU → Configuración → Datos técnicos (ApiKey, Merchant ID, Account ID).
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=

# --- Legado (opcional; si se define debe coincidir con PAYU_LATAM_ENV) ---
# PAYU_TEST=1
# PAYU_GATEWAY_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/

# --- URL pública de la tienda (webhook + retorno). En prod: https, sin localhost ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
PAYU_APP_URL=http://localhost:3001

# --- Firebase cliente (públicas, proyecto e-commerce-e629c) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SOLO servidor: webhook PayU) ---
# Consola Firebase → Configuración del proyecto → Cuentas de servicio → Generar clave privada
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Roles (misma lista que el dashboard, correos separados por coma) ---
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Mercado Pago Checkout Pro (COP) ---
# Tus integraciones → tu app → Credenciales de prueba / producción.
# Pruebas: TEST-... · Producción: APP_USR-... + MP_ENV=production.
MP_ENV=sandbox
# Access Token SOLO servidor (crea preferencias, consulta pagos).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks → Configurar notificación).
MP_WEBHOOK_SECRET=
# Public Key (pública; la usa el checkout).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Base pública (webhook + retornos). En prod: https sin localhost.
MP_APP_URL=http://localhost:3001
